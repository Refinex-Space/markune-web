{
  "name": "madora-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:static": "node scripts/check-static-output.mjs",
    "qa:capture": "node scripts/capture-design-qa.mjs",
    "qa:compare": "node scripts/compare-design-qa.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:static && pnpm test:e2e"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@thesvg/react": "3.2.8",
    "next": "16.2.6",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "4.1.14",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.37.0",
    "eslint-config-next": "16.2.6",
    "jsdom": "27.0.0",
    "pixelmatch": "7.1.0",
    "pngjs": "7.0.0",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.3",
    "vitest": "4.0.4"
  }
}
